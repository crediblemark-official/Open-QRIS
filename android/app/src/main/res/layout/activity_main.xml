<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- APP HEADER (BORDER-B) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/white">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_qris_logo"
            android:contentDescription="OpenQRIS Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OpenQRIS Listener"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background Notification Engine"
                android:textSize="10sp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Header Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. STATUS BANNER -->
            <LinearLayout
                android:id="@+id/status_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_status_warning">

                <TextView
                    android:id="@+id/tv_status_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Izin Akses Belum Diaktifkan"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tv_status_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktifkan izin akses notifikasi agar OpenQRIS dapat membaca pesan uang masuk."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

                <Button
                    android:id="@+id/btn_enable_permission"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Buka Izin Akses Notifikasi"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_primary"
                    android:layout_marginTop="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <TextView
                    android:id="@+id/btn_service_running"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Background Listener Siap"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/emerald_active"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- SECTION: CONFIGURATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KONFIGURASI GATEWAY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Server Webhook URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URL Webhook Listener Gateway:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_gateway_url"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="http://192.168.1.10:3000/v1/webhooks/listener"
                android:inputType="textUri"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <!-- Secret Key / Device Token -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device Token / API Key Merchant:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp" />

            <EditText
                android:id="@+id/et_secret_key"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="dev_... atau sk_live_..."
                android:inputType="text"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:fontFamily="monospace"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Tip: Tempelkan teks JSON Pairing dari dashboard ke kolom di atas untuk mengisi URL &amp; Token secara otomatis."
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="4dp" />

            <!-- App Filters -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aplikasi Target yang Didengarkan:"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <CheckBox
                    android:id="@+id/cb_dana"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DANA"
                    android:textSize="12sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cb_bca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BCA"
                    android:textSize="12sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cb_mandiri"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mandiri"
                    android:textSize="12sp"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_gopay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GoPay"
                    android:textSize="12sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cb_ovo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OVO"
                    android:textSize="12sp"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/cb_sms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SMS Banking"
                    android:textSize="12sp"
                    android:checked="true" />
            </LinearLayout>

            <!-- Buttons Action -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_save_config"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Simpan Pengaturan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/btn_primary"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_test_signal"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Tes Sinyal Gateway"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/btn_secondary"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- SECTION: LIVE LOGS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LOG NOTIFIKASI TERAKHIR"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_muted" />

                <TextView
                    android:id="@+id/btn_clear_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bersihkan Log"
                    android:textSize="11sp"
                    android:textColor="@color/brand_qris_red"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_empty_logs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada notifikasi yang ditangkap. Notifikasi uang masuk akan otomatis muncul di sini."
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:padding="16dp"
                android:gravity="center"
                android:background="@drawable/btn_secondary" />

            <ListView
                android:id="@+id/lv_logs"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
