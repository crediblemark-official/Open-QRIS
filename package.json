{
  "name": "openqris",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "hexclave dev --config-file ./hexclave.config.ts -- concurrently -k --prefix \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun run --watch src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun run src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@hexclave/js": "^1.0.123",
    "@types/canvas-confetti": "^1.9.0",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.3",
    "elysia": "^1.4.30",
    "jsqr": "^1.4.0",
    "lucide-vue-next": "^1.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@hexclave/cli": "^1.0.123",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}